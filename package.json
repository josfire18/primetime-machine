{
  "name": "primetime-machine",
  "version": "0.1.0",
  "private": true,
  "description": "Retro live TV from your own library: era-correct channels and commercials, a cable-style guide.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test core/test/*.test.ts station/test/*.test.ts && brs roku/source/schedule.brs roku-test/schedule_test.brs",
    "typecheck": "tsc -p .",
    "guide": "node core/cli.ts",
    "station": "node station/main.ts",
    "e2e": "python3 ui/test/e2e.py && python3 ui/test/editor_e2e.py && python3 ui/test/channels_e2e.py && python3 app/test/app_e2e.py",
    "app": "node node_modules/electron/install.js && electron app/main.mjs",
    "roku": "bsc",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@rokucommunity/brs": "^0.47.6",
    "@types/node": "^22.0.0",
    "brighterscript": "^0.73.8",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "@electron/universal": {
      "minimatch": "11.0.9"
    },
    "app-builder-lib": {
      "minimatch": "11.0.9"
    }
  },
  "main": "app/main.mjs",
  "author": "Joey Rockwood",
  "homepage": "https://github.com/josfire18/primetime-machine",
  "build": {
    "appId": "fyi.joeyrockwood.primetime-machine",
    "productName": "Primetime Machine",
    "directories": {
      "output": "build/dist"
    },
    "files": [
      "app/main.mjs",
      "app/icon.png",
      "core/src/**/*",
      "station/*.ts",
      "ui/**/*",
      "!ui/test/**",
      "package.json"
    ],
    "asar": true,
    "icon": "app/icon.png",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video",
      "icon": "app/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "publish": null
  }
}
