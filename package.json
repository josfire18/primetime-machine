{
  "name": "primetime-machine",
  "version": "0.1.0",
  "private": true,
  "description": "Retro live TV from your own library: era-correct channels and commercials, a cable-style guide.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test core/test/*.test.ts station/test/*.test.ts",
    "typecheck": "tsc -p .",
    "guide": "node core/cli.ts",
    "station": "node station/main.ts",
    "e2e": "python3 ui/test/e2e.py && python3 app/test/app_e2e.py",
    "app": "node node_modules/electron/install.js && electron app/main.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.4.1",
    "typescript": "^7.0.0"
  }
}
