<?xml version="1.0" encoding="utf-8" ?>
<!-- One GET to the station, off the render thread. Set `url`, then control = "RUN"; the
     parsed JSON (or an error) arrives in `response`. -->
<component name="StationTask" extends="Task">
  <interface>
    <field id="url" type="string" />
    <field id="tag" type="string" />
    <field id="response" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="StationTask.brs" />
</component>
